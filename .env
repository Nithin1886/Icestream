# =============================================================================
# IceStream Environment Configuration
# =============================================================================

# PostgreSQL Configuration
POSTGRES_USER=icestream
POSTGRES_PASSWORD=icestream_secret
POSTGRES_DB=icestream_analytics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://icestream:icestream_secret@localhost:5432/icestream_analytics

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_SERVERS=kafka:29092
KAFKA_TOPIC_EVENTS=raw-events
KAFKA_TOPIC_VALIDATED=validated-events

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Producer Configuration
PRODUCER_INTERVAL_MS=1500
STREAM_SIMULATOR_ACTIVE=true
